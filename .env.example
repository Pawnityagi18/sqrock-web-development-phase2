# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/workpulse

# Long random string used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If this is left unset, the server falls back to an insecure default and
# prints a warning on startup — always set a real value outside local dev.
JWT_SECRET=replace-this-with-a-long-random-string

# Port for the Express server
PORT=5000

# Razorpay TEST-MODE keys (get these from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# Webhook signing secret — set this up at Dashboard > Account & Settings > Webhooks,
# subscribe to the "payment.captured" event, and paste the secret you set there.
RAZORPAY_WEBHOOK_SECRET=...

# Base URL of your running frontend, used where the backend needs to build links back to it.
# Defaults to the request's own origin if omitted.
FRONTEND_URL=http://localhost:5173
