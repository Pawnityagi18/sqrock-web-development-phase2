# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/workpulse

# Long random string used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If this is left unset, the server falls back to an insecure default and
# prints a warning on startup — always set a real value outside local dev.
JWT_SECRET=replace-this-with-a-long-random-string

# Port for the Express server
PORT=5000

# Stripe TEST-MODE keys (get these from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — when testing locally, run:
#   stripe listen --forward-to localhost:5000/api/payments/webhook
# and paste the "whsec_..." it prints here.
STRIPE_WEBHOOK_SECRET=whsec_...

# Base URL of your running frontend, used for Stripe redirect/onboarding return links.
# Defaults to the request's own origin if omitted.
FRONTEND_URL=http://localhost:5173
