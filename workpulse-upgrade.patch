+  const token = getAuthToken();
+  const result = await safeFetchJson(`${API_BASE_URL}/uploads/avatar`, {
+    method: 'POST',
+    headers: token ? { Authorization: `Bearer ${token}` } : {}, // no Content-Type — browser sets multipart boundary
